# ──────────────────────────────────────────────
# SUPABASE (PostgreSQL)
# Lấy từ: Supabase Dashboard → Settings → Database
# ──────────────────────────────────────────────

# Runtime connection pooling (Supabase transaction pooler; recommended for serverless)
# Start with one Prisma connection per function instance to avoid multiplying pools.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# Direct connection (dùng cho Prisma migrate / seed)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase API (lấy từ Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://zrkfhjwcgjdxuimshbpx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_K12g2Cq3UVL2_TTXppHCtw_hdkfRk3L"
# Server-only key for the authenticated Next.js upload endpoint. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-cloud-api-key

# ──────────────────────────────────────────────
# SITE
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nhakhoa2000.com

# Admin (chạy npm run admin:credentials để tạo hash và secret)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=



# ──────────────────────────────────────────────
# CLOUDINARY (tuỳ chọn — upload ảnh)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
