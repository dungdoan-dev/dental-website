

# Supabase Data API + Auth (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[publishable-or-anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[server-only-service-role-key]"
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-cloud-api-key

# ──────────────────────────────────────────────
# SITE
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nhakhoa2000.com

# ──────────────────────────────────────────────
# DATABASE & THÔNG BÁO (chỉ dùng ở server)
# ──────────────────────────────────────────────
# Required only for deploying migrations; never expose it in client code.
DATABASE_URL=

# Optional email notifications. Without these, bookings remain visible in admin
# and notification jobs wait in the database instead of being discarded.
RESEND_API_KEY=
APPOINTMENT_EMAIL_FROM=
APPOINTMENT_EMAIL_TO=
# Schedule GET /api/appointments/notifications with Authorization: Bearer <secret>.
CRON_SECRET=
# Enable only when your reverse proxy overwrites x-forwarded-for.
APPOINTMENT_TRUST_PROXY=false
